<div class="publications">
  {% assign selected_publications = page.selected_publications | sort: 'sort_date' | reverse %}
  <ol class="bibliography">
    {% for paper in selected_publications %}
      <li>
        <div class="row">
          {% if site.enable_publication_thumbnails %}
            <div class="col-sm-2 abbr">
              <abbr class="badge">{{ paper.venue | escape }}</abbr>
            </div>
          {% endif %}
          <div class="{% if site.enable_publication_thumbnails %}col-sm-10{% else %}col-12{% endif %}">
            <div class="title">
              <a href="{{ paper.arxiv | escape }}">{{ paper.title | escape }}</a>
            </div>
            <div class="author">
              {% for author in paper.authors %}
                {%- unless forloop.first %}, {% endunless -%}
                {%- if author == 'Nikita P. Kalinin' -%}
                  <em>{{ author | escape }}</em>
                {%- else -%}
                  {{ author | escape }}
                {%- endif -%}
              {% endfor %}
            </div>
            <div class="periodical">
              <em>{{ paper.venue | escape }} {{ paper.year }}</em>
            </div>
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
